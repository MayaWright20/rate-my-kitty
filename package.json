{
  "name": "rate-my-kitty",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "test": "jest --watch",
    "test:all": "jest --watch && npx jest --coverage && open coverage/lcov-report/index.html",
    "test:all-tests": "npx jest --coverage --coverageDirectory=coverage/unit-tests-coverage && open coverage/unit-tests-coverage/lcov-report/index.html && npx jest context/__tests__/voting-context.integration.test.tsx --coverage --coverageDirectory=coverage/integration-tests-coverage && open coverage/integration-tests-coverage/lcov-report/index.html",
    "test:integrations": "npx jest --testMatch='**/*.integration.test.tsx' --coverage --coverageDirectory=coverage/integration-tests-coverage && open coverage/integration-tests-coverage/lcov-report/index.html",
    "test:units": "npx jest --coverage --coverageDirectory=coverage/unit-tests-coverage && open coverage/unit-tests-coverage/lcov-report/index.html",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/lilita-one": "^0.4.1",
    "@expo-google-fonts/permanent-marker": "^0.4.0",
    "@expo-google-fonts/supermercado-one": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@testing-library/react-native": "^14.0.1",
    "expo": "^57.0.8",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "fast-text-encoding": "^1.0.6",
    "git-filter-repo": "^0.0.30",
    "jest-expo": "~57.0.2",
    "lottie-react-native": "~7.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "msw": "^2.14.6",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  },
  "private": true
}